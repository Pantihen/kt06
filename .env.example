# ================= Приложение =================
PORT=3000
NODE_ENV=development
# За прокси (Render, Railway, nginx) поставьте 1, чтобы rate limit видел реальный IP клиента
TRUST_PROXY=0

# ================= PostgreSQL =================
# Используются контейнером db в docker-compose.yml
POSTGRES_USER=blog
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=blog
POSTGRES_PORT=5432

# Подключение приложения при запуске без Docker (npm run dev).
# В docker compose адрес переопределяется на хост db автоматически.
DATABASE_URL="postgresql://blog:change_me_db_password@localhost:5432/blog?schema=public"
# Тесты работают в отдельной схеме test той же базы
TEST_DATABASE_URL="postgresql://blog:change_me_db_password@localhost:5432/blog?schema=test"

# ================= Redis =================
# Хранилище rate limit и отозванных refresh-токенов. Пусто — хранение в памяти процесса.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ================= JWT =================
# Замените на длинные случайные строки:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ================= Чат (Socket.io) =================
# Разрешённые origin для WebSocket через запятую (пусто — только тот же origin)
CLIENT_ORIGIN=http://localhost:3000
CHAT_HISTORY_LIMIT=50
CHAT_MAX_MESSAGE_LENGTH=1000

# ================= Первый администратор =================
# Создаётся при старте контейнера (npm run seed). Пусто — пропускается.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin_password
# Необязательно: демо-модератор
SEED_MODERATOR_EMAIL=
SEED_MODERATOR_PASSWORD=
